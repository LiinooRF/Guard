# ---------------------------------------------------------------------------
# VoxIA Control — plantilla de entorno. Copiar a .env y rellenar.
#
# REGLA: este archivo se commitea SIN valores reales. El .env con valores nunca
# entra al repo (esta en .gitignore). En staging y produccion los valores viven
# en Dokploy, no en un archivo.
# ---------------------------------------------------------------------------

NODE_ENV=development

# --- Base de datos -------------------------------------------------------
POSTGRES_USER=voxia
POSTGRES_PASSWORD=cambiar_en_local
POSTGRES_DB=voxia
POSTGRES_PORT=5432

# Usuario de aplicacion: NO es superusuario y NO tiene BYPASSRLS, para que las
# politicas de aislamiento entre empresas se apliquen de verdad. Ver issue #7.
DATABASE_URL=postgresql://voxia_app:cambiar_en_local@localhost:5432/voxia
# Solo para migraciones/limpieza local. La API nunca debe usar esta URL.
DATABASE_ADMIN_URL=postgresql://voxia:cambiar_en_local@localhost:5432/voxia
# Solo se inyecta al comando de migración en despliegues; nunca al proceso API.
DATABASE_MIGRATION_URL=
DATABASE_APP_USER=voxia_app
DATABASE_APP_PASSWORD=cambiar_en_local

# --- Respaldos de PostgreSQL (issue #24, ver docs/respaldos.md) -----------
# Dias que el servicio postgres-backup conserva los dumps diarios en el
# volumen backup_data; los mas antiguos se borran despues de cada dump.
BACKUP_RETENTION_DAYS=14
# TODO(#24): copia FUERA del VPS (rclone hacia S3/Backblaze/R2). Falta elegir
# destino y credenciales; vacia = los dumps quedan solo en el disco del VPS.
BACKUP_REMOTE=

# --- Redis: sesiones, refresh tokens, rate limiting y colas ---------------
REDIS_URL=redis://localhost:6379
# BullMQ: se alerta si la operacion mas antigua por sincronizar supera este umbral.
SCAN_SYNC_QUEUE_NAME=scan-sync
SCAN_SYNC_LAG_ALERT_SECONDS=300

# --- Autenticacion -------------------------------------------------------
# Generar con: openssl rand -base64 48
JWT_SECRET=cambiar_por_un_secreto_largo_y_aleatorio
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Datos demo exclusivamente locales. El seed se niega a ejecutarse en producción.
# Cambiar el valor en .env; no reutilizar esta credencial fuera del entorno local.
DEMO_PASSWORD=

# --- Correo --------------------------------------------------------------
# Proveedor aun SIN DECIDIR (ver issue #9). El codigo va contra la interfaz
# MailProvider, asi que elegir despues no cuesta nada.
#
# Valores de MAIL_DRIVER:
#   mailpit  desarrollo: captura todo, no sale nada a internet
#   smtp     cualquier servidor SMTP — Postal o Mailu self-hosted, un relay
#            externo, SES, lo que sea. Solo hay que llenar SMTP_*.
#
# El driver `smtp` generico cubre cualquier proveedor, asi que no hace falta un
# adaptador por marca hasta que se decida y haya una razon concreta.
MAIL_DRIVER=mailpit
MAIL_FROM="VoxIA Control <no-reply@localhost>"
MAILPIT_HOST=localhost
MAILPIT_PORT=1025
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# true en produccion; en local Mailpit acepta conexiones sin cifrar
SMTP_SECURE=false

# --- Mapas ---------------------------------------------------------------
# OpenStreetMap. OJO: los tiles publicos de tile.openstreetmap.org tienen
# politica de uso restringida y bloquean apps con trafico real. Para staging y
# produccion hay que usar un proveedor con capa gratuita o tiles propios.
# Ver issue #15.
MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
MAP_ATTRIBUTION=(c) OpenStreetMap contributors

# --- Almacenamiento de evidencia fotografica -----------------------------
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./storage

# --- URLs ----------------------------------------------------------------
API_PORT=3001
API_PUBLIC_URL=http://localhost:3001
WEB_PORT=3000
WEB_PUBLIC_URL=http://localhost:3000

# --- Despliegue VPS / Traefik -------------------------------------------
APP_DOMAIN=
ACME_EMAIL=

# Donde se guardan las fotos de evidencia. En Dokploy apunta al volumen
# persistente (/data/evidence); sin eso, un redeploy las borra.
EVIDENCE_PATH=./storage/evidence
