# ---------------------------------------------------------------------------
# VoxIA Control — plantilla de entorno. Copiar a .env y rellenar.
#
# REGLA: este archivo se commitea SIN valores reales. El .env con valores nunca
# entra al repo (esta en .gitignore). En staging y produccion los valores viven
# en Dokploy, no en un archivo.
# ---------------------------------------------------------------------------

NODE_ENV=development

# --- Base de datos -------------------------------------------------------
POSTGRES_USER=voxia
POSTGRES_PASSWORD=cambiar_en_local
POSTGRES_DB=voxia
POSTGRES_PORT=5432

# Usuario de aplicacion: NO es superusuario y NO tiene BYPASSRLS, para que las
# politicas de aislamiento entre empresas se apliquen de verdad. Ver issue #7.
DATABASE_URL=postgresql://voxia_app:cambiar_en_local@localhost:5432/voxia
DATABASE_APP_USER=voxia_app
DATABASE_APP_PASSWORD=cambiar_en_local

# --- Redis: sesiones, refresh tokens, rate limiting y colas ---------------
REDIS_URL=redis://localhost:6379

# --- Autenticacion -------------------------------------------------------
# Generar con: openssl rand -base64 48
JWT_SECRET=cambiar_por_un_secreto_largo_y_aleatorio
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# --- Correo --------------------------------------------------------------
# Proveedor aun sin decidir (ver issue #9). El codigo va contra una interfaz,
# asi que cambiar de proveedor es cambiar MAIL_DRIVER.
# Valores: mailpit | smtp | brevo
MAIL_DRIVER=mailpit
MAIL_FROM="VoxIA Control <no-reply@localhost>"
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
BREVO_API_KEY=

# --- Mapas ---------------------------------------------------------------
# OpenStreetMap. OJO: los tiles publicos de tile.openstreetmap.org tienen
# politica de uso restringida y bloquean apps con trafico real. Para staging y
# produccion hay que usar un proveedor con capa gratuita o tiles propios.
# Ver issue #15.
MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
MAP_ATTRIBUTION=(c) OpenStreetMap contributors

# --- Almacenamiento de evidencia fotografica -----------------------------
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./storage

# --- URLs ----------------------------------------------------------------
API_PORT=3001
API_PUBLIC_URL=http://localhost:3001
WEB_PORT=3000
WEB_PUBLIC_URL=http://localhost:3000
