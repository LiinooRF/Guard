{
  "name": "sentrycore",
  "version": "0.1.0",
  "private": true,
  "description": "SaaS multi-tenant de monitoreo de rondas de vigilancia con etiquetas NFC",
  "workspaces": [
    "packages/*",
    "apps/api",
    "apps/web"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "infra:logs": "docker compose logs -f",
    "infra:reset": "docker compose down -v && docker compose up -d",
    "dev:api": "npm run dev --workspace @sentrycore/api",
    "dev:web": "npm run dev --workspace @sentrycore/web",
    "dev:mobile": "npm --prefix apps/mobile run start",
    "build": "npm run build --workspace @sentrycore/shared && npm run build --workspace @sentrycore/api && npm run build --workspace @sentrycore/web",
    "bridge:check": "npm --prefix apps/mobile run bridge:check",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint . --max-warnings 0",
    "test": "npm run test --workspaces --if-present"
  },
  "overrides": {
    "postcss": "8.5.25",
    "sharp": "0.35.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.22",
    "typescript-eslint": "^8.65.0"
  }
}
